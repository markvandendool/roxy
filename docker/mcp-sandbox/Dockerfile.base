# MCP Sandbox Base Image
# Secure, minimal base for all MCP servers

FROM node:20-alpine

# Security: Run as non-root
RUN addgroup -g 1000 mcp && \
    adduser -u 1000 -G mcp -s /bin/sh -D mcp

# Install security tools
RUN apk add --no-cache \
    bubblewrap \
    libseccomp \
    ca-certificates \
    tzdata

# Create sandbox directories
RUN mkdir -p /sandbox/work /sandbox/allowed /sandbox/logs && \
    chown -R mcp:mcp /sandbox

# Set up read-only root with writable workdir
WORKDIR /sandbox/work
USER mcp

# Security labels
LABEL security.scan="passed" \
      sandbox.enabled="true" \
      mcp.version="2024-11-05"

# Default: execute MCP server with sandbox wrapper
ENTRYPOINT ["/usr/local/bin/mcp-sandbox-wrapper"]
